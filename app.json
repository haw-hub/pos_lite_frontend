{
  "expo": {
    "name": "POS Myanmar",
    "slug": "pos-myanmar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pos.myanmar",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSBluetoothAlwaysUsageDescription": "POS Myanmar app သည် Bluetooth printer နှင့် barcode scanner ချိတ်ဆက်ရန် Bluetooth အသုံးပြုခွင့် လိုအပ်ပါသည်။",
        "NSBluetoothPeripheralUsageDescription": "POS Myanmar app သည် Bluetooth printer နှင့် barcode scanner ချိတ်ဆက်ရန် Bluetooth အသုံးပြုခွင့် လိုအပ်ပါသည်။"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "package": "com.pos.myanmar",
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "POS Myanmar app သည် ဘားကုဒ်စကင်န်ဖတ်ရန် ကင်မရာအသုံးပြုခွင့် လိုအပ်ပါသည်။"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#2E7D32"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      "expo-status-bar",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "2a39b8a3-f0cf-4804-ad84-c7919b861d2e"
      }
    },
    "owner": "htetaungwai.dev"
  }
}
